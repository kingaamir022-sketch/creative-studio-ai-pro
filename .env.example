# CreativeStudio AI Pro — environment configuration
# Copy to .env and fill in. NEVER commit a real .env with keys.

# Server
PORT=4820
HOST=127.0.0.1

# Data locations (defaults shown)
DB_PATH=./data/creative-studio.db
UPLOADS_DIR=./uploads

# Upload limit in MB (default 200)
MAX_UPLOAD_MB=200

# Encryption key for stored provider API keys (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random key is generated once and saved to data/.app-key (do NOT delete that file
# or stored provider keys become unreadable).
APP_ENCRYPTION_KEY=

# AI provider keys (optional in Phase 1 — leave blank until Phase 7).
# Keys can also be saved per-installation from Settings > AI Providers (stored encrypted).
# NEVER put real keys in frontend code.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_KEY=
DEEPGRAM_API_KEY=
RUNWAY_API_KEY=
